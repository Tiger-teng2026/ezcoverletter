# Server-only. Copy to .env.local and replace the placeholders.
# Do not commit real values. Do not prefix these names with NEXT_PUBLIC_.
#
# Local sandbox: Creem test API, test API key, and a test-mode product ID.
# Production: leave CREEM_API_URL empty, use the live API key, and set
# CREEM_PRODUCT_ID to the live product ID kept in lib/constants.ts.
# Do not put sandbox keys in the Vercel production environment.

DEEPSEEK_API_KEY=your_deepseek_api_key
CREEM_API_KEY=your_creem_api_key
CREEM_API_URL=
CREEM_PRODUCT_ID=your_creem_product_id
CREEM_CREATOR_PRODUCT_ID=your_creator_subscription_product_id
CREEM_PRO_PRODUCT_ID=your_pro_subscription_product_id
CREEM_WEBHOOK_SECRET=your_creem_webhook_secret
ENTITLEMENT_SECRET=your_long_random_secret
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
